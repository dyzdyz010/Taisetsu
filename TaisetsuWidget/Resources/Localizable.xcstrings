        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정된 날과 가장 가까운 소중한 날을 자동으로 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra automaticamente datas fixadas e as mais próximas."
