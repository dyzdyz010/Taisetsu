    "Taisetsu can automatically keep your important days in a dedicated Calendar. You can change the scope later in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taisetsu kann deine wichtigen Tage automatisch in einem eigenen Kalender verwalten. Den Umfang kannst du später in den Einstellungen ändern."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taisetsu kan automatisk samle viktige dager i en egen kalender. Du kan endre omfanget senere i Innstillinger."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taisetsu 可自动将重要日保存在专用日历中。你可以稍后在设置中修改范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
