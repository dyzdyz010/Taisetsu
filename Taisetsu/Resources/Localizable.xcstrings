    "Lunar month intervals count leap months and may land in a different numbered month." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتسب فواصل الأشهر القمرية الأشهر الكبيسة، وقد تقع لاحقًا في شهر ذي رقم مختلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondmonat-Intervalle zählen Schaltmonate mit und können künftig in einem anders nummerierten Monat liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los intervalos de meses lunares cuentan los meses intercalares y pueden caer en un mes con otro número."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les intervalles en mois lunaires comptent les mois intercalaires et peuvent tomber sur un autre numéro de mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli intervalli in mesi lunari includono i mesi intercalari e possono cadere in un mese con numero diverso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧暦の月間隔には閏月も含まれるため、将来は異なる月番号になることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음력 월 간격에는 윤달도 포함되므로 이후에는 다른 월 번호에 해당할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalos em meses lunares contam meses intercalares e podem cair em um mês de número diferente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "农历月间隔会计入闰月，因此未来可能落在不同编号的月份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "農曆月間隔會計入閏月，因此未來可能落在不同編號的月份。"
          }
        }
      }
    },
