    "Your data stays on your device and in your private iCloud database." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى بياناتك على جهازك وفي قاعدة بيانات iCloud الخاصة بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf deinem Gerät und in deiner privaten iCloud-Datenbank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos permanecen en tu dispositivo y en tu base de datos privada de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données restent sur votre appareil et dans votre base iCloud privée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati restano sul dispositivo e nel tuo database iCloud privato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データはデバイスと非公開のiCloudデータベースに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터는 기기와 비공개 iCloud 데이터베이스에 저장됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados ficam no dispositivo e no seu banco de dados privado do iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据保存在你的设备与私人 iCloud 数据库中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料會保留在你的裝置與私人 iCloud 資料庫中。"
