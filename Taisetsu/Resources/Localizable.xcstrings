    "Lunar month intervals count leap months and may land in a different numbered month." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondmonat-Intervalle zählen Schaltmonate mit und können künftig in einem anders nummerierten Monat liegen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Månedsintervaller i månekalenderen teller med skuddmåneder og kan ende i en måned med et annet nummer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "农历月间隔会计入闰月，因此未来可能落在不同编号的月份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "農曆月間隔會計入閏月，因此未來可能落在不同編號的月份。"
          }
        }
      }
    },
